<section{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}"{% endif %} class="af af--{{ section.settings.surface }} af-section{% if section.settings.padding == 'tight' %} af-section--tight{% elsif section.settings.padding == 'flush-top' %} af-section--flush-top{% endif %}">
  <div class="af-container">
    {%- render 'af-head', s: section.settings -%}
    <div class="af-grid af-grid--{{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign tag = 'div'
          if b.link != blank
            assign tag = 'a'
          endif
        -%}
        <{{ tag }} class="af-card{% if section.settings.card_style == 'plain' %} af-card--plain{% elsif section.settings.card_style == 'muted' %} af-card--muted{% endif %} af-reveal"{% if b.link != blank %} href="{{ b.link }}"{% endif %} {{ block.shopify_attributes }}>
          {%- if b.image -%}
            <div class="af-card__media" style="aspect-ratio: {{ section.settings.ratio }};">
              {{ b.image | image_url: width: 1400 | image_tag: widths: '400,600,800,1000,1400', sizes: '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw', loading: 'lazy', alt: b.image.alt | default: b.title }}
            </div>
          {%- endif -%}
          <div class="af-card__body">
            {%- if b.eyebrow != blank -%}<div class="af-card__eyebrow">{{ b.eyebrow | escape }}</div>{%- endif -%}
            {%- if b.title != blank -%}<div class="af-card__title">{{ b.title | escape }}</div>{%- endif -%}
            {%- if b.text != blank -%}<div class="af-card__text">{{ b.text }}</div>{%- endif -%}
            {%- if b.link_label != blank -%}<div class="af-card__footer"><span class="af-link">{{ b.link_label | escape }}</span></div>{%- endif -%}
          </div>
        </{{ tag }}>
      {%- endfor -%}
    </div>
    {%- render 'af-buttons', s: section.settings, center: true -%}
  </div>
</section>

{% schema %}
{"name":"AF · Cards","tag":"div","class":"af-section-wrapper","settings":[{"type":"select","id":"surface","label":"Background","options":[{"value":"light","label":"White"},{"value":"mist","label":"Mist (light gray)"},{"value":"ice","label":"Ice (light blue)"},{"value":"navy","label":"Navy gradient"},{"value":"blueprint","label":"Navy blueprint grid"}],"default":"light"},{"type":"select","id":"padding","label":"Vertical spacing","options":[{"value":"normal","label":"Normal"},{"value":"tight","label":"Tight"},{"value":"flush-top","label":"No top spacing"}],"default":"normal"},{"type":"text","id":"anchor","label":"Anchor ID","info":"Optional. Lets you link to this section with #anchor-id"},{"type":"header","content":"Heading"},{"type":"text","id":"eyebrow","label":"Eyebrow"},{"type":"text","id":"heading","label":"Heading"},{"type":"richtext","id":"lead","label":"Intro text"},{"type":"select","id":"head_align","label":"Heading alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"split","label":"Split (heading left, intro right)"}],"default":"left"},{"type":"header","content":"Layout"},{"type":"select","id":"columns","label":"Columns","options":[{"value":"2","label":"2"},{"value":"3","label":"3"},{"value":"4","label":"4"}],"default":"3"},{"type":"select","id":"card_style","label":"Card style","options":[{"value":"default","label":"Bordered"},{"value":"muted","label":"Filled"},{"value":"plain","label":"Plain"}],"default":"default"},{"type":"select","id":"ratio","label":"Image shape","options":[{"value":"4 / 3","label":"Landscape"},{"value":"16 / 10","label":"Wide"},{"value":"1 / 1","label":"Square"},{"value":"4 / 5","label":"Portrait"}],"default":"4 / 3"},{"type":"header","content":"Buttons"},{"type":"text","id":"btn1_label","label":"Primary button label"},{"type":"url","id":"btn1_link","label":"Primary button link"},{"type":"select","id":"btn1_style","label":"Primary button style","options":[{"value":"navy","label":"Navy"},{"value":"accent","label":"Blue"}],"default":"navy"},{"type":"text","id":"btn2_label","label":"Secondary button label"},{"type":"url","id":"btn2_link","label":"Secondary button link"}],"blocks":[{"type":"card","name":"Card","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"eyebrow","label":"Eyebrow"},{"type":"text","id":"title","label":"Title","default":"Card title"},{"type":"richtext","id":"text","label":"Text"},{"type":"text","id":"link_label","label":"Link label"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"AF · Cards","blocks":[{"type":"card"},{"type":"card"},{"type":"card"}]}]}
{% endschema %}