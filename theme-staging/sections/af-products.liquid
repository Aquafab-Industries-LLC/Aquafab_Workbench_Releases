<section{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}"{% endif %} class="af af--{{ section.settings.surface }}{% if section.settings.surface == 'steel' or section.settings.surface == 'deep' or section.settings.surface == 'slate' or section.settings.surface == 'photo' %} af--navy{% endif %} af-section{% if section.settings.padding == 'tight' %} af-section--tight{% elsif section.settings.padding == 'flush-top' %} af-section--flush-top{% endif %}">
  <div class="af-container">
    {%- render 'af-head', s: section.settings -%}
    {%- liquid
      assign src = section.settings.collection
      if src == blank and collection
        assign src = collection
      endif
    -%}
    {%- if src != blank and src.products_count > 0 -%}
      {%- paginate src.products by section.settings.limit -%}
        <div class="af-products">
          {%- for product in src.products -%}
            {%- render 'af-product-card', product: product -%}
          {%- endfor -%}
        </div>
      {%- endpaginate -%}
    {%- else -%}
      <div class="af-empty af-reveal">
        <h3 class="af-h3" style="margin-bottom:10px">{{ section.settings.empty_heading | escape }}</h3>
        <div>{{ section.settings.empty_text }}</div>
        <div class="af-btns af-btns--center"><a class="af-btn" href="/pages/request-a-quote">Request a quote</a><a class="af-btn af-btn--ghost" href="/pages/custom-engineering">Custom engineering</a></div>
      </div>
    {%- endif -%}
    {%- render 'af-buttons', s: section.settings, center: true -%}
  </div>
</section>

{% schema %}
{"name":"AF · Product grid","tag":"div","class":"af-section-wrapper","settings":[{"type":"select","id":"surface","label":"Background","options":[{"value":"light","label":"White"},{"value":"mist","label":"Mist (light gray)"},{"value":"ice","label":"Ice (light blue)"},{"value":"navy","label":"Navy gradient"},{"value":"blueprint","label":"Navy blueprint grid"},{"value":"stone","label":"Stone (warm light gray)"}],"default":"light"},{"type":"select","id":"padding","label":"Vertical spacing","options":[{"value":"normal","label":"Normal"},{"value":"tight","label":"Tight"},{"value":"flush-top","label":"No top spacing"}],"default":"normal"},{"type":"text","id":"anchor","label":"Anchor ID","info":"Optional. Lets you link to this section with #anchor-id"},{"type":"header","content":"Heading"},{"type":"text","id":"eyebrow","label":"Eyebrow"},{"type":"text","id":"heading","label":"Heading"},{"type":"richtext","id":"lead","label":"Intro text"},{"type":"select","id":"head_align","label":"Heading alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"split","label":"Split (heading left, intro right)"}],"default":"left"},{"type":"collection","id":"collection","label":"Collection","info":"Leave blank on collection pages to use the current collection"},{"type":"range","id":"limit","label":"Products to show","min":3,"max":48,"step":3,"default":24},{"type":"text","id":"empty_heading","label":"Empty state heading","default":"Configurations are available on request"},{"type":"richtext","id":"empty_text","label":"Empty state text","default":"<p>Tell us about your experiment and our engineering team will specify a system to match.</p>"},{"type":"header","content":"Buttons"},{"type":"text","id":"btn1_label","label":"Primary button label"},{"type":"url","id":"btn1_link","label":"Primary button link"},{"type":"select","id":"btn1_style","label":"Primary button style","options":[{"value":"navy","label":"Navy"},{"value":"accent","label":"Blue"}],"default":"navy"},{"type":"text","id":"btn2_label","label":"Secondary button label"},{"type":"url","id":"btn2_link","label":"Secondary button link"}],"presets":[{"name":"AF · Product grid"}]}
{% endschema %}