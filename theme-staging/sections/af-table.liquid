<section{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}"{% endif %} class="af af--{{ section.settings.surface }}{% if section.settings.surface == 'steel' or section.settings.surface == 'deep' or section.settings.surface == 'slate' or section.settings.surface == 'photo' %} af--navy{% endif %} af-section{% if section.settings.padding == 'tight' %} af-section--tight{% elsif section.settings.padding == 'flush-top' %} af-section--flush-top{% endif %}">
  <div class="af-container">
    {%- render 'af-head', s: section.settings -%}
    <div class="af-table-wrap af-reveal">
      <table class="af-table">
        {%- if section.settings.h1 != blank or section.settings.h2 != blank or section.settings.h3 != blank -%}
          <thead><tr>
            {%- if section.settings.h1 != blank -%}<th scope="col">{{ section.settings.h1 | escape }}</th>{%- else -%}<td></td>{%- endif -%}
            {%- if section.settings.h2 != blank -%}<th scope="col">{{ section.settings.h2 | escape }}</th>{%- endif -%}
            {%- if section.settings.h3 != blank -%}<th scope="col">{{ section.settings.h3 | escape }}</th>{%- endif -%}
          </tr></thead>
        {%- endif -%}
        <tbody>
          {%- for block in section.blocks -%}
            {%- if block.type == 'group' -%}
              <tr class="af-table__group" {{ block.shopify_attributes }}><td colspan="3">{{ block.settings.label | escape }}</td></tr>
            {%- else -%}
              <tr {{ block.shopify_attributes }}>
                <td>{{ block.settings.c1 | escape }}</td>
                {%- if section.settings.h2 != blank or block.settings.c2 != blank -%}<td>{{ block.settings.c2 | escape }}</td>{%- endif -%}
                {%- if section.settings.h3 != blank or block.settings.c3 != blank -%}<td>{{ block.settings.c3 | escape }}</td>{%- endif -%}
              </tr>
            {%- endif -%}
          {%- endfor -%}
        </tbody>
      </table>
    </div>
    {%- if section.settings.note != blank -%}<div class="af-small af-muted" style="margin-top:16px">{{ section.settings.note }}</div>{%- endif -%}
    {%- render 'af-buttons', s: section.settings -%}
  </div>
</section>

{% schema %}
{"name":"AF · Table","tag":"div","class":"af-section-wrapper","settings":[{"type":"select","id":"surface","label":"Background","options":[{"value":"light","label":"White"},{"value":"mist","label":"Mist (light gray)"},{"value":"ice","label":"Ice (light blue)"},{"value":"navy","label":"Navy gradient"},{"value":"blueprint","label":"Navy blueprint grid"},{"value":"stone","label":"Stone (warm light gray)"}],"default":"light"},{"type":"select","id":"padding","label":"Vertical spacing","options":[{"value":"normal","label":"Normal"},{"value":"tight","label":"Tight"},{"value":"flush-top","label":"No top spacing"}],"default":"normal"},{"type":"text","id":"anchor","label":"Anchor ID","info":"Optional. Lets you link to this section with #anchor-id"},{"type":"header","content":"Heading"},{"type":"text","id":"eyebrow","label":"Eyebrow"},{"type":"text","id":"heading","label":"Heading"},{"type":"richtext","id":"lead","label":"Intro text"},{"type":"select","id":"head_align","label":"Heading alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"split","label":"Split (heading left, intro right)"}],"default":"left"},{"type":"header","content":"Columns"},{"type":"text","id":"h1","label":"Column 1 header","default":"Option"},{"type":"text","id":"h2","label":"Column 2 header","default":"Configuration"},{"type":"text","id":"h3","label":"Column 3 header","default":"Description"},{"type":"richtext","id":"note","label":"Footnote"},{"type":"header","content":"Buttons"},{"type":"text","id":"btn1_label","label":"Primary button label"},{"type":"url","id":"btn1_link","label":"Primary button link"},{"type":"select","id":"btn1_style","label":"Primary button style","options":[{"value":"navy","label":"Navy"},{"value":"accent","label":"Blue"}],"default":"navy"},{"type":"text","id":"btn2_label","label":"Secondary button label"},{"type":"url","id":"btn2_link","label":"Secondary button link"}],"blocks":[{"type":"group","name":"Group heading","settings":[{"type":"text","id":"label","label":"Label","default":"Group"}]},{"type":"row","name":"Row","settings":[{"type":"text","id":"c1","label":"Column 1","default":"Row"},{"type":"text","id":"c2","label":"Column 2"},{"type":"textarea","id":"c3","label":"Column 3"}]}],"presets":[{"name":"AF · Table","blocks":[{"type":"row"},{"type":"row"}]}]}
{% endschema %}