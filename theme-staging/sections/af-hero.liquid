{%- liquid
  assign s = section.settings
-%}
<section class="af af-hero{% if s.layout == 'center' %} af-hero--center{% endif %}{% if s.height == 'compact' %} af-hero--compact{% endif %}">
  {%- if s.image -%}
    <div class="af-hero__media">
      {{ s.image | image_url: width: 2800 | image_tag: widths: '750,1100,1500,2000,2800', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: s.image.alt | default: s.heading }}
    </div>
  {%- endif -%}
  <div class="af-container af-hero__inner">
    <div class="af-hero__content">
      {%- if s.eyebrow != blank -%}<p class="af-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      <h1 class="af-h1">{{ s.heading | escape }}</h1>
      {%- if s.text != blank -%}<div class="af-lead">{{ s.text }}</div>{%- endif -%}
      {%- render 'af-buttons', s: s -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <div class="af-hero__stats">
        {%- for block in section.blocks -%}
          <div class="af-hero__stat" {{ block.shopify_attributes }}>
            <div class="af-hero__stat-value">{{ block.settings.value | escape }}</div>
            <div class="af-hero__stat-label">{{ block.settings.label | escape }}</div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{"name":"AF · Hero","tag":"div","class":"af-section-wrapper","settings":[{"type":"image_picker","id":"image","label":"Background image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Aquatic research engineering"},{"type":"text","id":"heading","label":"Heading","default":"Research equipment, engineered around your experiment."},{"type":"richtext","id":"text","label":"Text"},{"type":"select","id":"layout","label":"Layout","options":[{"value":"left","label":"Left aligned"},{"value":"center","label":"Centered"}],"default":"left"},{"type":"select","id":"height","label":"Height","options":[{"value":"full","label":"Large"},{"value":"compact","label":"Compact"}],"default":"full"},{"type":"header","content":"Buttons"},{"type":"text","id":"btn1_label","label":"Primary button label","default":"Explore systems"},{"type":"url","id":"btn1_link","label":"Primary button link"},{"type":"select","id":"btn1_style","label":"Primary button style","options":[{"value":"navy","label":"Navy"},{"value":"accent","label":"Blue"}],"default":"navy"},{"type":"text","id":"btn2_label","label":"Secondary button label","default":"Start a custom project"},{"type":"url","id":"btn2_link","label":"Secondary button link"}],"blocks":[{"type":"stat","name":"Stat","limit":4,"settings":[{"type":"text","id":"value","label":"Value","default":"0–500 cm/s"},{"type":"text","id":"label","label":"Label","default":"Programmable flow range"}]}],"presets":[{"name":"AF · Hero"}]}
{% endschema %}