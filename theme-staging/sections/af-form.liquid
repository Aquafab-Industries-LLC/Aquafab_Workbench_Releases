{%- assign s = section.settings -%}
<section{% if s.anchor != blank %} id="{{ s.anchor | handleize }}"{% endif %} class="af af--{{ s.surface }} af-section{% if s.padding == 'tight' %} af-section--tight{% elsif s.padding == 'flush-top' %} af-section--flush-top{% endif %}">
  <div class="af-container">
    <div class="af-form-layout">
      <div class="af-reveal">
        {%- if s.eyebrow != blank -%}<p class="af-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="af-h2">{{ s.heading | escape }}</h2>
        {%- if s.lead != blank -%}<div class="af-rte af-rte--checks" style="margin-top:20px">{{ s.lead }}</div>{%- endif -%}
        {%- if s.show_contact -%}
          <ul class="af-contact-list">
            <li><span class="af-feature__icon">{% render 'af-icon', name: 'phone' %}</span><div><strong>Call</strong><a href="tel:+15137818010">+1 (513) 781-8010</a></div></li>
            <li><span class="af-feature__icon">{% render 'af-icon', name: 'mail' %}</span><div><strong>Email</strong><a href="mailto:{{ s.email | default: 'sales@aquafabindustries.com' }}">{{ s.email | default: 'sales@aquafabindustries.com' }}</a></div></li>
            <li><span class="af-feature__icon">{% render 'af-icon', name: 'pin' %}</span><div><strong>Workshop &amp; office</strong>2291 Morning Watch<br>Cincinnati, OH 45244</div></li>
            <li><span class="af-feature__icon">{% render 'af-icon', name: 'clock' %}</span><div><strong>Response time</strong>Within one business day</div></li>
          </ul>
        {%- endif -%}
      </div>
      <div class="af-form-card af-reveal">
        {%- form 'contact', id: section.id -%}
          {%- assign sid = section.id -%}
          <div class="af-form">
            {%- if form.posted_successfully? -%}
              <div class="af-alert af-alert--success">{% case s.kind %}{% when 'quote' %}Thank you — your request is in. An Aquafab engineer will reply with a formal, itemized quote, typically within 2 business days.{% when 'custom' %}Thank you — we have your project details. An engineer will reach out within 2 business days to schedule a scoping call.{% when 'support' %}Thank you — your support request has been logged. We respond within one business day, and the same day when an experiment is affected.{% when 'partner' %}Thank you for reaching out. We will be in touch within a few business days to talk about your work.{% when 'educator' %}Thank you — we will follow up with recommended equipment and teaching resources for your course.{% when 'vendor' %}Thank you — your vendor packet request is in. We'll email the documents the same business day.{% when 'license' %}Thank you — your license request is in. We'll email your Aquafab Workbench license key, usually within one business day.{% else %}Thank you — your message was sent. We reply to every inquiry within one business day.{% endcase %}</div>
            {%- elsif form.errors -%}
              <div class="af-alert af-alert--error">{{ form.errors | default_errors }}</div>
            {%- endif -%}
            <input type="hidden" name="contact[Request type]" value="{{ s.kind | capitalize }} — {{ page.title | default: request.path }}">
            <div class="af-form__section">Your details</div>
            <div class="af-field"><label for="f-name-{{ sid }}">Full name <span class="af-req">*</span></label><input id="f-name-{{ sid }}" name="contact[name]" autocomplete="name" required></div>
            <div class="af-field"><label for="f-email-{{ sid }}">Work email <span class="af-req">*</span></label><input id="f-email-{{ sid }}" type="email" name="contact[email]" autocomplete="email" required></div>
            <div class="af-field"><label for="f-phone-{{ sid }}">Phone</label><input id="f-phone-{{ sid }}" type="tel" name="contact[phone]" autocomplete="tel"></div>
            <div class="af-field"><label for="f-inst-{{ sid }}">Institution / organization <span class="af-req">*</span></label><input id="f-inst-{{ sid }}" name="contact[Institution]" autocomplete="organization" required></div>
            <div class="af-field"><label for="f-dept-{{ sid }}">Department, lab or PI</label><input id="f-dept-{{ sid }}" name="contact[Department or lab]"></div>
            <div class="af-field"><label for="f-otype-{{ sid }}">Organization type</label><select id="f-otype-{{ sid }}" name="contact[Organization type]"><option value="">Select…</option><option>University or college</option><option>K–12 school</option><option>Public aquarium, zoo or museum</option><option>Government agency or laboratory</option><option>Private research or industry</option><option>Other</option></select></div>
            {%- case s.kind -%}
              {%- when 'quote' -%}
                <div class="af-form__section">What you need</div>
                <div class="af-field"><label for="f-prod-{{ sid }}">System or product of interest <span class="af-req">*</span></label><input id="f-prod-{{ sid }}" name="contact[Product]" required data-af-prefill="product" placeholder="e.g. Alpha Flow Chamber, 10 ft test section"></div>
                <div class="af-field"><label for="f-qty-{{ sid }}">Quantity</label><input id="f-qty-{{ sid }}" type="number" min="1" name="contact[Quantity]" placeholder="1"></div>
                <div class="af-field"><label for="f-time-{{ sid }}">Timeline</label><select id="f-time-{{ sid }}" name="contact[Timeline]"><option value="">Select…</option><option>As soon as possible</option><option>Within 3 months</option><option>3–6 months</option><option>6–12 months</option><option>Budgeting for next fiscal year</option></select></div>
                <div class="af-field"><label for="f-fund-{{ sid }}">Funding status</label><select id="f-fund-{{ sid }}" name="contact[Funding status]"><option value="">Select…</option><option>Funds available</option><option>Grant awarded</option><option>Grant proposal in progress (need a budget quote)</option><option>Exploring options</option></select></div>
                <div class="af-field"><label for="f-pay-{{ sid }}">Preferred payment</label><select id="f-pay-{{ sid }}" name="contact[Payment method]"><option value="">Select…</option><option>Purchase order</option><option>Credit card</option><option>Not sure yet</option></select></div>
                <div class="af-field"><label for="f-loc-{{ sid }}">Delivery city / state</label><input id="f-loc-{{ sid }}" name="contact[Delivery location]"></div>
                <div class="af-field af-field--full"><label for="f-body-{{ sid }}">Requirements &amp; notes</label><textarea id="f-body-{{ sid }}" name="contact[body]" placeholder="Species or specimens, dimensions, flow and temperature ranges, sensors, space or utility constraints."></textarea></div>
              {%- when 'custom' -%}
                <div class="af-form__section">Your project</div>
                <div class="af-field"><label for="f-ptype-{{ sid }}">Project type</label><select id="f-ptype-{{ sid }}" name="contact[Project type]"><option value="">Select…</option><option>Flow chamber / flume</option><option>Respirometry system</option><option>Life-support or animal-care system</option><option>Display or habitat aquarium</option><option>Sensor, robotics or electronics</option><option>Automation or control retrofit</option><option>Something else</option></select></div>
                <div class="af-field"><label for="f-org-{{ sid }}">Organisms or specimens</label><input id="f-org-{{ sid }}" name="contact[Organisms]" placeholder="e.g. juvenile salmonids, mussels, zebrafish larvae"></div>
                <div class="af-field"><label for="f-size-{{ sid }}">Approximate size or volume</label><input id="f-size-{{ sid }}" name="contact[Size]" placeholder="e.g. 3 m test section, 200 L"></div>
                <div class="af-field"><label for="f-env-{{ sid }}">Flow, temperature &amp; water needs</label><input id="f-env-{{ sid }}" name="contact[Environmental requirements]" placeholder="e.g. 0–150 cm/s, 4–30 °C, seawater"></div>
                <div class="af-field"><label for="f-time-{{ sid }}">Timeline</label><select id="f-time-{{ sid }}" name="contact[Timeline]"><option value="">Select…</option><option>As soon as possible</option><option>Within 3 months</option><option>3–6 months</option><option>6–12 months</option><option>Grant-dependent</option></select></div>
                <div class="af-field"><label for="f-budget-{{ sid }}">Budget range</label><select id="f-budget-{{ sid }}" name="contact[Budget]"><option value="">Select…</option><option>Under $10,000</option><option>$10,000–$25,000</option><option>$25,000–$50,000</option><option>$50,000–$100,000</option><option>$100,000+</option><option>Need guidance</option></select></div>
                <div class="af-field af-field--full"><label for="f-body-{{ sid }}">Describe the experiment or goal <span class="af-req">*</span></label><textarea id="f-body-{{ sid }}" name="contact[body]" required placeholder="What question are you trying to answer? What hasn't worked with existing equipment? Sketches are welcome — we'll reply with a link to send files."></textarea></div>
              {%- when 'support' -%}
                <div class="af-form__section">Your system</div>
                <div class="af-field"><label for="f-prod-{{ sid }}">Product or system <span class="af-req">*</span></label><input id="f-prod-{{ sid }}" name="contact[Product]" required data-af-prefill="topic"></div>
                <div class="af-field"><label for="f-serial-{{ sid }}">Serial or order number</label><input id="f-serial-{{ sid }}" name="contact[Serial or order number]"></div>
                <div class="af-field"><label for="f-topic-{{ sid }}">Topic</label><select id="f-topic-{{ sid }}" name="contact[Support topic]"><option value="">Select…</option><option>Installation or setup</option><option>Aquafab Workbench software</option><option>Calibration</option><option>Maintenance or replacement parts</option><option>Warranty claim</option><option>Documentation request</option><option>Training</option><option>Other</option></select></div>
                <div class="af-field"><label for="f-urg-{{ sid }}">Urgency</label><select id="f-urg-{{ sid }}" name="contact[Urgency]"><option value="">Select…</option><option>Experiment currently affected</option><option>Within the week</option><option>General question</option></select></div>
                <div class="af-field af-field--full"><label for="f-body-{{ sid }}">Describe the issue <span class="af-req">*</span></label><textarea id="f-body-{{ sid }}" name="contact[body]" required placeholder="What happened, what you've tried, and any error messages or readings. Photos or video help — we'll reply with an upload link."></textarea></div>
              {%- when 'partner' -%}
                <div class="af-form__section">Your research</div>
                <div class="af-field"><label for="f-area-{{ sid }}">Research area</label><input id="f-area-{{ sid }}" name="contact[Research area]" placeholder="e.g. intertidal physiology, biomechanics"></div>
                <div class="af-field"><label for="f-sys-{{ sid }}">Aquafab systems you use</label><input id="f-sys-{{ sid }}" name="contact[Systems in use]"></div>
                <div class="af-field"><label for="f-collab-{{ sid }}">How would you like to collaborate?</label><select id="f-collab-{{ sid }}" name="contact[Collaboration]"><option value="">Select…</option><option>Share a publication or citation</option><option>Co-author a research spotlight</option><option>Beta-test new equipment</option><option>Co-develop a new instrument</option><option>Develop a teaching module</option><option>Several of these</option></select></div>
                <div class="af-field"><label for="f-link-{{ sid }}">Publication or lab page link</label><input id="f-link-{{ sid }}" type="url" name="contact[Link]" placeholder="https://"></div>
                <div class="af-field af-field--full"><label for="f-body-{{ sid }}">Tell us about your work</label><textarea id="f-body-{{ sid }}" name="contact[body]"></textarea></div>
              {%- when 'educator' -%}
                <div class="af-form__section">Your course</div>
                <div class="af-field"><label for="f-course-{{ sid }}">Course or program</label><input id="f-course-{{ sid }}" name="contact[Course]"></div>
                <div class="af-field"><label for="f-level-{{ sid }}">Level</label><select id="f-level-{{ sid }}" name="contact[Level]"><option value="">Select…</option><option>Middle school</option><option>High school</option><option>Community college</option><option>Undergraduate</option><option>Graduate</option><option>Outreach / informal education</option></select></div>
                <div class="af-field"><label for="f-size-{{ sid }}">Students per lab section</label><input id="f-size-{{ sid }}" type="number" min="1" name="contact[Class size]"></div>
                <div class="af-field"><label for="f-time-{{ sid }}">When do you need equipment?</label><select id="f-time-{{ sid }}" name="contact[Timeline]"><option value="">Select…</option><option>This semester</option><option>Next semester</option><option>Next academic year</option><option>Writing a grant</option></select></div>
                <div class="af-field af-field--full"><label for="f-topics-{{ sid }}">Topics you want to teach</label><input id="f-topics-{{ sid }}" name="contact[Topics]" placeholder="e.g. boundary layers, metabolic rate, laminar vs. turbulent flow"></div>
                <div class="af-field af-field--full"><label for="f-body-{{ sid }}">Anything else?</label><textarea id="f-body-{{ sid }}" name="contact[body]"></textarea></div>
              {%- when 'license' -%}
                <div class="af-form__section">Your system</div>
                <div class="af-field"><label for="f-prod-{{ sid }}">Aquafab system <span class="af-req">*</span></label><input id="f-prod-{{ sid }}" name="contact[Product]" required placeholder="e.g. Standard Respirometry System, 5 L"></div>
                <div class="af-field"><label for="f-serial-{{ sid }}">Serial or order number</label><input id="f-serial-{{ sid }}" name="contact[Serial or order number]" placeholder="If you have one"></div>
                <div class="af-field af-field--full"><label for="f-lab-{{ sid }}">Lab name to show in the software <span class="af-req">*</span></label><input id="f-lab-{{ sid }}" name="contact[License lab name]" required placeholder="e.g. Smith Lab, University of Cincinnati"></div>
                <div class="af-field af-field--full"><label for="f-body-{{ sid }}">Anything else?</label><textarea id="f-body-{{ sid }}" name="contact[body]" placeholder="A replacement for a lost key, a loan or trial system, or other questions."></textarea></div>
              {%- when 'vendor' -%}
                <div class="af-form__section">Your vendor setup</div>
                <div class="af-field"><label for="f-ap-{{ sid }}">Procurement / AP contact email</label><input id="f-ap-{{ sid }}" type="email" name="contact[Procurement contact]" placeholder="If different from yours"></div>
                <div class="af-field"><label for="f-portal-{{ sid }}">Supplier portal or registration link</label><input id="f-portal-{{ sid }}" type="url" name="contact[Supplier portal]" placeholder="https://"></div>
                <div class="af-field af-field--full"><span class="af-field__label">Documents you need</span>
                  <div class="af-checks">
                    <label><input type="checkbox" name="contact[Needs W-9]" value="Yes" checked> W-9</label>
                    <label><input type="checkbox" name="contact[Needs insurance certificate]" value="Yes"> Certificate of insurance</label>
                    <label><input type="checkbox" name="contact[Needs ACH form]" value="Yes"> ACH / remittance details</label>
                    <label><input type="checkbox" name="contact[Needs supplier form]" value="Yes"> Our completion of your supplier form</label>
                    <label><input type="checkbox" name="contact[Needs sole-source letter]" value="Yes"> Sole-source justification letter</label>
                    <label><input type="checkbox" name="contact[Needs capability statement]" value="Yes"> Capability statement</label>
                  </div>
                </div>
                <div class="af-field af-field--full"><label for="f-body-{{ sid }}">Anything else?</label><textarea id="f-body-{{ sid }}" name="contact[body]" placeholder="Deadlines, PO number, the quote this relates to, or forms to complete."></textarea></div>
              {%- else -%}
                <div class="af-form__section">Your message</div>
                <div class="af-field af-field--full"><label for="f-topic-{{ sid }}">Topic</label><select id="f-topic-{{ sid }}" name="contact[Topic]" data-af-prefill="topic"><option value="">Select…</option><option>Sales question</option><option>Quote request</option><option>Custom project</option><option>Technical support</option><option>Procurement / vendor registration</option><option>Research collaboration</option><option>Media or other</option></select></div>
                <div class="af-field af-field--full"><label for="f-body-{{ sid }}">Message <span class="af-req">*</span></label><textarea id="f-body-{{ sid }}" name="contact[body]" required></textarea></div>
            {%- endcase -%}
            <div class="af-form__actions">
              <button type="submit" class="af-btn af-btn--accent">{% case s.kind %}{% when 'quote' %}Request my quote{% when 'custom' %}Start my project{% when 'support' %}Submit support request{% when 'partner' %}Send application{% when 'vendor' %}Send me the vendor packet{% when 'license' %}Request my license key{% else %}Send message{% endcase %}</button>
              <span class="af-form__privacy">Your details are used only to respond to this request.</span>
            </div>
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{"name":"AF · Form","tag":"div","class":"af-section-wrapper","settings":[{"type":"select","id":"surface","label":"Background","options":[{"value":"light","label":"White"},{"value":"mist","label":"Mist (light gray)"},{"value":"ice","label":"Ice (light blue)"},{"value":"navy","label":"Navy gradient"},{"value":"blueprint","label":"Navy blueprint grid"}],"default":"light"},{"type":"select","id":"padding","label":"Vertical spacing","options":[{"value":"normal","label":"Normal"},{"value":"tight","label":"Tight"},{"value":"flush-top","label":"No top spacing"}],"default":"normal"},{"type":"text","id":"anchor","label":"Anchor ID"},{"type":"select","id":"kind","label":"Form type","options":[{"value":"quote","label":"Quote request"},{"value":"custom","label":"Custom project"},{"value":"support","label":"Support request"},{"value":"partner","label":"Research partner"},{"value":"educator","label":"Educator"},{"value":"vendor","label":"Vendor packet request"},{"value":"license","label":"License key request"},{"value":"general","label":"General contact"}],"default":"general"},{"type":"text","id":"eyebrow","label":"Eyebrow"},{"type":"text","id":"heading","label":"Heading","default":"Get in touch"},{"type":"richtext","id":"lead","label":"Side text"},{"type":"checkbox","id":"show_contact","label":"Show contact details","default":true},{"type":"text","id":"email","label":"Email shown","default":"sales@aquafabindustries.com"}],"presets":[{"name":"AF · Form"}]}
{% endschema %}