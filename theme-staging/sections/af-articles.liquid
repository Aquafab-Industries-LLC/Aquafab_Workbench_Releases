<section{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}"{% endif %} class="af af--{{ section.settings.surface }} af-section{% if section.settings.padding == 'tight' %} af-section--tight{% elsif section.settings.padding == 'flush-top' %} af-section--flush-top{% endif %}">
  <div class="af-container">
    {%- render 'af-head', s: section.settings -%}
    {%- assign b = section.settings.blog | default: blogs.research -%}
    {%- if b.articles_count > 0 -%}
      <div class="af-grid af-grid--3">
        {%- for article in b.articles limit: section.settings.limit -%}
          <a class="af-card af-article-card af-reveal" href="{{ article.url }}">
            <div class="af-card__media">
              {%- if article.image -%}{{ article.image | image_url: width: 1200 | image_tag: widths: '400,600,900,1200', sizes: '(min-width: 1024px) 33vw, 100vw', loading: 'lazy', alt: article.image.alt | default: article.title }}{%- endif -%}
            </div>
            <div class="af-card__body">
              <div class="af-card__eyebrow">{% if article.tags.size > 0 %}{{ article.tags.first | escape }}{% else %}{{ b.title | escape }}{% endif %}</div>
              <div class="af-card__title">{{ article.title | escape }}</div>
              <div class="af-card__text">{{ article.excerpt_or_content | strip_html | truncatewords: 28 }}</div>
              <div class="af-card__footer"><span class="af-link">Read the story</span></div>
            </div>
          </a>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="af-empty"><p>New research stories are on the way.</p></div>
    {%- endif -%}
    {%- render 'af-buttons', s: section.settings, center: true -%}
  </div>
</section>

{% schema %}
{"name":"AF · Articles","tag":"div","class":"af-section-wrapper","settings":[{"type":"select","id":"surface","label":"Background","options":[{"value":"light","label":"White"},{"value":"mist","label":"Mist (light gray)"},{"value":"ice","label":"Ice (light blue)"},{"value":"navy","label":"Navy gradient"},{"value":"blueprint","label":"Navy blueprint grid"}],"default":"light"},{"type":"select","id":"padding","label":"Vertical spacing","options":[{"value":"normal","label":"Normal"},{"value":"tight","label":"Tight"},{"value":"flush-top","label":"No top spacing"}],"default":"normal"},{"type":"text","id":"anchor","label":"Anchor ID","info":"Optional. Lets you link to this section with #anchor-id"},{"type":"header","content":"Heading"},{"type":"text","id":"eyebrow","label":"Eyebrow"},{"type":"text","id":"heading","label":"Heading"},{"type":"richtext","id":"lead","label":"Intro text"},{"type":"select","id":"head_align","label":"Heading alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"split","label":"Split (heading left, intro right)"}],"default":"left"},{"type":"blog","id":"blog","label":"Blog"},{"type":"range","id":"limit","label":"Articles","min":3,"max":12,"step":3,"default":3},{"type":"header","content":"Buttons"},{"type":"text","id":"btn1_label","label":"Primary button label"},{"type":"url","id":"btn1_link","label":"Primary button link"},{"type":"select","id":"btn1_style","label":"Primary button style","options":[{"value":"navy","label":"Navy"},{"value":"accent","label":"Blue"}],"default":"navy"},{"type":"text","id":"btn2_label","label":"Secondary button label"},{"type":"url","id":"btn2_link","label":"Secondary button link"}],"presets":[{"name":"AF · Articles"}]}
{% endschema %}