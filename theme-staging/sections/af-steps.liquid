<section{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}"{% endif %} class="af af--{{ section.settings.surface }}{% if section.settings.surface == 'deep' or section.settings.surface == 'slate' or section.settings.surface == 'photo' %} af--navy{% endif %} af-section{% if section.settings.padding == 'tight' %} af-section--tight{% elsif section.settings.padding == 'flush-top' %} af-section--flush-top{% endif %}">
  <div class="af-container">
    {%- render 'af-head', s: section.settings -%}
    <div class="af-steps">
      {%- for block in section.blocks -%}
        <div class="af-step af-reveal" {{ block.shopify_attributes }}>
          <h3 class="af-step__title af-h4">{{ block.settings.title | escape }}</h3>
          <div class="af-step__text">{{ block.settings.text }}</div>
        </div>
      {%- endfor -%}
    </div>
    {%- render 'af-buttons', s: section.settings, center: true -%}
  </div>
</section>

{% schema %}
{"name":"AF · Process steps","tag":"div","class":"af-section-wrapper","settings":[{"type":"select","id":"surface","label":"Background","options":[{"value":"light","label":"White"},{"value":"mist","label":"Mist (light gray)"},{"value":"ice","label":"Ice (light blue)"},{"value":"navy","label":"Navy gradient"},{"value":"blueprint","label":"Navy blueprint grid"},{"value":"deep","label":"Deep water (teal to navy)"},{"value":"slate","label":"Slate (dark charcoal)"}],"default":"light"},{"type":"select","id":"padding","label":"Vertical spacing","options":[{"value":"normal","label":"Normal"},{"value":"tight","label":"Tight"},{"value":"flush-top","label":"No top spacing"}],"default":"normal"},{"type":"text","id":"anchor","label":"Anchor ID","info":"Optional. Lets you link to this section with #anchor-id"},{"type":"header","content":"Heading"},{"type":"text","id":"eyebrow","label":"Eyebrow"},{"type":"text","id":"heading","label":"Heading"},{"type":"richtext","id":"lead","label":"Intro text"},{"type":"select","id":"head_align","label":"Heading alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"split","label":"Split (heading left, intro right)"}],"default":"left"},{"type":"header","content":"Buttons"},{"type":"text","id":"btn1_label","label":"Primary button label"},{"type":"url","id":"btn1_link","label":"Primary button link"},{"type":"select","id":"btn1_style","label":"Primary button style","options":[{"value":"navy","label":"Navy"},{"value":"accent","label":"Blue"}],"default":"navy"},{"type":"text","id":"btn2_label","label":"Secondary button label"},{"type":"url","id":"btn2_link","label":"Secondary button link"}],"blocks":[{"type":"step","name":"Step","settings":[{"type":"text","id":"title","label":"Title","default":"Step"},{"type":"richtext","id":"text","label":"Text"}]}],"presets":[{"name":"AF · Process steps","blocks":[{"type":"step"},{"type":"step"},{"type":"step"},{"type":"step"}]}]}
{% endschema %}