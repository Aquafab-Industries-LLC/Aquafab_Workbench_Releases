<section{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}"{% endif %} class="af af--{{ section.settings.surface }}{% if section.settings.surface == 'steel' or section.settings.surface == 'deep' or section.settings.surface == 'slate' or section.settings.surface == 'photo' %} af--navy{% endif %} af-section{% if section.settings.padding == 'tight' %} af-section--tight{% elsif section.settings.padding == 'flush-top' %} af-section--flush-top{% endif %}">
  <div class="af-container">
    {%- render 'af-head', s: section.settings -%}
    {%- assign entries = shop.metaobjects.aquafab_resource.values -%}
    <div data-af-library>
      {%- comment -%}
        Chips are kinds of document; the select is the system. Manuals and
        quick-start guides are one chip ("manuals" is in both rows' data-cat,
        set in af-resource-row). A chip with nothing under it is not shown.
        Below the bar, documents are grouped by system family, and machine
        profiles sit in their own group after the software. A group whose
        rows a filter has hidden hides itself (CSS :has).
      {%- endcomment -%}
      {%- liquid
        assign n_manuals = 0
        assign n_software = 0
        assign n_spec = 0
        assign n_training = 0
        assign n_procurement = 0
        assign n_video = 0
        for r in entries
          case r.resource_type.value
            when 'Manual', 'Quick-start guide'
              assign n_manuals = n_manuals | plus: 1
            when 'Software', 'Machine profile'
              assign n_software = n_software | plus: 1
            when 'Spec sheet'
              assign n_spec = n_spec | plus: 1
            when 'Training'
              assign n_training = n_training | plus: 1
            when 'Procurement'
              assign n_procurement = n_procurement | plus: 1
            when 'Video'
              assign n_video = n_video | plus: 1
          endcase
        endfor
      -%}
      <div class="af-lib__bar">
        <div class="af-lib__filters" role="toolbar" aria-label="Filter resources">
          <button type="button" class="af-chip" data-af-filter="all" aria-pressed="true">All</button>
          {%- if n_manuals > 0 -%}<button type="button" class="af-chip" data-af-filter="manuals" aria-pressed="false">Manuals &amp; guides</button>{%- endif -%}
          {%- if n_software > 0 -%}<button type="button" class="af-chip" data-af-filter="software" aria-pressed="false">Software</button>{%- endif -%}
          {%- if n_spec > 0 -%}<button type="button" class="af-chip" data-af-filter="spec-sheet" aria-pressed="false">Spec sheets</button>{%- endif -%}
          {%- if n_training > 0 -%}<button type="button" class="af-chip" data-af-filter="training" aria-pressed="false">Training</button>{%- endif -%}
          {%- if n_video > 0 -%}<button type="button" class="af-chip" data-af-filter="video" aria-pressed="false">Videos</button>{%- endif -%}
          {%- if n_procurement > 0 -%}<button type="button" class="af-chip" data-af-filter="procurement" aria-pressed="false">Procurement</button>{%- endif -%}
        </div>
        {%- assign fams = '' -%}
        {%- for r in entries -%}{%- if r.system_family.value != blank -%}{%- assign fh = r.system_family.value | handleize -%}{%- unless fams contains fh -%}{%- assign fams = fams | append: fh | append: '|' | append: r.system_family.value | append: ';;' -%}{%- endunless -%}{%- endif -%}{%- endfor -%}
        {%- assign famlist = fams | split: ';;' -%}
        <label class="af-lib__system"><span class="af-visually-hidden">Filter by system</span>
          <select data-af-sys>
            <option value="">All systems</option>
            {%- for f in famlist -%}{%- assign fp = f | split: '|' -%}{%- if fp[0] != blank and fp[0] != 'general' -%}<option value="{{ fp[0] }}">{{ fp[1] | escape }}</option>{%- endif -%}{%- endfor -%}
          </select>
        </label>
        <label class="af-lib__search"><span class="af-visually-hidden">Search resources</span>{% render 'af-icon', name: 'search' %}<input type="search" placeholder="Search by product or keyword" data-af-search></label>
      </div>
      {%- for f in famlist -%}
        {%- assign fp = f | split: '|' -%}
        {%- if fp[0] == blank or fp[0] == 'general' -%}{%- continue -%}{%- endif -%}
        <div class="af-lib__group af-lib__group--fam">
          <h3 class="af-lib__group-title">{{ fp[1] | escape }}</h3>
          <div class="af-lib__list">
            {%- for r in entries -%}{%- assign rh = r.system_family.value | handleize -%}{%- if rh == fp[0] and r.resource_type.value != 'Machine profile' -%}{%- render 'af-resource-row', r: r -%}{%- endif -%}{%- endfor -%}
          </div>
        </div>
      {%- endfor -%}
      <div class="af-lib__group af-lib__group--fam">
        <h3 class="af-lib__group-title">General</h3>
        <div class="af-lib__list">
          {%- for r in entries -%}{%- assign rh = r.system_family.value | handleize -%}{%- if rh == blank or rh == 'general' -%}{%- unless r.resource_type.value == 'Machine profile' -%}{%- render 'af-resource-row', r: r -%}{%- endunless -%}{%- endif -%}{%- endfor -%}
        </div>
      </div>
      {%- assign profile_count = 0 -%}
      {%- for r in entries -%}{%- if r.resource_type.value == 'Machine profile' -%}{%- assign profile_count = profile_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
      {%- if profile_count > 0 -%}
        <div class="af-lib__group af-lib__group--profiles">
          <div class="af-lib__group-head">
            <h3 class="af-h4">Machine profiles</h3>
            <p>Ready-made machine configurations for Aquafab Workbench. The software already includes them under + Add Machine; download one to restore or share a configuration. Adding or importing a machine needs a license.</p>
          </div>
          <div class="af-lib__list">
            {%- for r in entries -%}{%- if r.resource_type.value == 'Machine profile' -%}{%- render 'af-resource-row', r: r -%}{%- endif -%}{%- endfor -%}
          </div>
        </div>
      {%- endif -%}
      <div class="af-empty" data-af-noresults{% if entries.size > 0 %} hidden{% endif %} style="margin-top:12px">
        <h3 class="af-h4" style="margin-bottom:8px">{{ section.settings.empty_heading | escape }}</h3>
        <div>{{ section.settings.empty_text }}</div>
        <div class="af-btns af-btns--center"><a class="af-btn" href="/pages/resources#request-file" data-af-request="">Request a document</a></div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Documents grouped by system; machine profiles apart (overrides aquafab-overrides.css). */
  .af-lib__group { margin-top: 28px; padding-top: 0; border-top: 0; }
  .af-lib__group-title { margin: 0 0 10px; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--af-text); }
  .af-lib__group--profiles { margin-top: 36px; padding-top: 28px; border-top: 1px solid var(--af-line); }
</style>
<script>
  /* The system select. aquafab.js applies the chip and the search; this
     runs after it (listening on the library, so the chip's own handler goes
     first) and also hides rows of other systems. */
  (function () {
    var lib = document.currentScript.parentElement.querySelector('[data-af-library]');
    if (!lib) return;
    var sel = lib.querySelector('[data-af-sys]');
    var empty = lib.querySelector('[data-af-noresults]');
    function bySystem() {
      var sys = sel ? sel.value : '';
      var shown = 0;
      lib.querySelectorAll('[data-af-res]').forEach(function (it) {
        if (sys && it.dataset.sys !== sys) it.hidden = true;
        if (!it.hidden) shown++;
      });
      if (empty) empty.hidden = shown > 0;
    }
    function reapply() {
      var search = lib.querySelector('[data-af-search]');
      if (search) search.dispatchEvent(new Event('input', { bubbles: true }));
    }
    lib.addEventListener('click', function (e) { if (e.target.closest('[data-af-filter]')) setTimeout(bySystem, 0); });
    lib.addEventListener('input', function (e) { if (e.target.matches('[data-af-search]')) setTimeout(bySystem, 0); });
    if (sel) sel.addEventListener('change', reapply);
    setTimeout(bySystem, 0);
  })();
</script>

