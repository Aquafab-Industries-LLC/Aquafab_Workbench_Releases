{%- assign s = section.settings -%}
<section{% if s.anchor != blank %} id="{{ s.anchor | handleize }}"{% endif %} class="af af--{{ s.surface }}{% if s.surface == 'steel' or s.surface == 'deep' or s.surface == 'slate' or s.surface == 'photo' %} af--navy{% endif %} af-section{% if s.padding == 'tight' %} af-section--tight{% elsif s.padding == 'flush-top' %} af-section--flush-top{% endif %}">
  <div class="af-container">
    <div class="af-cta af-cta--{{ s.style }}{% if s.image %} af-cta--photo{% endif %} af-reveal">
      {%- if s.image -%}
        <div class="af-cta__media">{{ s.image | image_url: width: 2400 | image_tag: widths: '800,1200,1600,2400', sizes: '100vw', loading: 'lazy', alt: '' }}</div>
      {%- endif -%}
      <div>
        {%- if s.eyebrow != blank -%}<p class="af-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="af-h2">{{ s.heading | escape }}</h2>
        {%- if s.text != blank -%}<div class="af-lead">{{ s.text }}</div>{%- endif -%}
        {%- if s.show_contact -%}
          <div class="af-cta__contact">
            <a href="tel:+15137818010">+1 (513) 781-8010</a>
            <a href="mailto:sales@aquafabindustries.com">sales@aquafabindustries.com</a>
          </div>
        {%- endif -%}
      </div>
      {%- render 'af-buttons', s: s -%}
    </div>
  </div>
</section>

{% schema %}
{"name":"AF · Call to action","tag":"div","class":"af-section-wrapper","settings":[{"type":"select","id":"surface","label":"Background","options":[{"value":"light","label":"White"},{"value":"mist","label":"Mist (light gray)"},{"value":"ice","label":"Light gray (same as Mist)"},{"value":"navy","label":"Navy"},{"value":"blueprint","label":"Navy blueprint grid"},{"value":"stone","label":"Pale blue"}],"default":"light"},{"type":"select","id":"padding","label":"Vertical spacing","options":[{"value":"normal","label":"Normal"},{"value":"tight","label":"Tight"},{"value":"flush-top","label":"No top spacing"}],"default":"normal"},{"type":"text","id":"anchor","label":"Anchor ID","info":"Optional. Lets you link to this section with #anchor-id"},{"type":"select","id":"style","label":"Panel style","options":[{"value":"navy","label":"Navy"},{"value":"ice","label":"Light gray"}],"default":"navy"},{"type":"image_picker","id":"image","label":"Background photo","info":"Navy panel only. Darkened on the text side, like the home page header."},{"type":"text","id":"eyebrow","label":"Eyebrow"},{"type":"text","id":"heading","label":"Heading","default":"Let's engineer your next experiment."},{"type":"richtext","id":"text","label":"Text"},{"type":"checkbox","id":"show_contact","label":"Show phone and email","default":true},{"type":"header","content":"Buttons"},{"type":"text","id":"btn1_label","label":"Primary button label","default":"Request a quote"},{"type":"url","id":"btn1_link","label":"Primary button link"},{"type":"select","id":"btn1_style","label":"Primary button style","options":[{"value":"navy","label":"Navy"},{"value":"accent","label":"Blue"}],"default":"navy"},{"type":"text","id":"btn2_label","label":"Secondary button label","default":"Talk to an engineer"},{"type":"url","id":"btn2_link","label":"Secondary button link"}],"presets":[{"name":"AF · Call to action"}]}
{% endschema %}