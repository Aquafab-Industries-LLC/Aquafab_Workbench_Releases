{%- liquid
  assign s = section.settings
  assign title = s.heading
  if title == blank
    if article
      assign title = article.title
    elsif collection
      assign title = collection.title
    elsif page
      assign title = page.title
    elsif blog
      assign title = blog.title
    endif
  endif
  assign intro = s.text
  if intro == blank and collection and collection.description != blank
    assign intro = collection.description
  endif
  if intro == blank and article and article.excerpt != blank
    assign intro = article.excerpt
  endif
  assign img = s.image
  if img == blank and s.use_resource_image
    if article and article.image
      assign img = article.image
    elsif collection and collection.image
      assign img = collection.image
    endif
  endif
-%}
<section class="af af--{{ s.surface }}{% if s.surface == 'deep' or s.surface == 'slate' or s.surface == 'photo' %} af--navy{% endif %} af-page-hero{% unless img %} af-page-hero--no-image{% endunless %}">
  <div class="af-container af-page-hero__inner">
    <div class="af-page-hero__content">
      {%- if s.show_crumbs -%}
        <nav aria-label="Breadcrumb">
          <ol class="af-crumbs">
            <li><a href="{{ routes.root_url }}">Home</a></li>
            {%- if s.parent_label != blank -%}<li><a href="{{ s.parent_link | default: '#' }}">{{ s.parent_label | escape }}</a></li>{%- endif -%}
            <li aria-current="page">{{ s.crumb_label | default: title | escape }}</li>
          </ol>
        </nav>
      {%- endif -%}
      {%- if s.eyebrow != blank -%}<p class="af-eyebrow">{{ s.eyebrow | escape }}</p>{%- elsif article and article.tags.size > 0 -%}<p class="af-eyebrow">{{ article.tags.first | escape }}</p>{%- endif -%}
      <h1 class="af-h1">{{ title | escape }}</h1>
      {%- if intro != blank -%}<div class="af-lead">{{ intro }}</div>{%- endif -%}
      {%- render 'af-buttons', s: s -%}
      {%- if section.blocks.size > 0 -%}
        <div class="af-page-hero__meta">
          {%- for block in section.blocks -%}
            <div class="af-page-hero__meta-item" {{ block.shopify_attributes }}><strong>{{ block.settings.label | escape }}</strong>{{ block.settings.value | escape }}</div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    {%- if img -%}
      <div class="af-page-hero__image">
        {{ img | image_url: width: 1600 | image_tag: widths: '600,900,1200,1600', sizes: '(min-width: 900px) 45vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: img.alt | default: title }}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{"name":"AF · Page header","tag":"div","class":"af-section-wrapper","settings":[{"type":"select","id":"surface","label":"Background","options":[{"value":"light","label":"White"},{"value":"mist","label":"Mist (light gray)"},{"value":"ice","label":"Ice (light blue)"},{"value":"navy","label":"Navy gradient"},{"value":"blueprint","label":"Navy blueprint grid"},{"value":"deep","label":"Deep water (teal to navy)"},{"value":"slate","label":"Slate (dark charcoal)"}],"default":"mist"},{"type":"checkbox","id":"show_crumbs","label":"Show breadcrumbs","default":true},{"type":"text","id":"parent_label","label":"Breadcrumb parent label"},{"type":"url","id":"parent_link","label":"Breadcrumb parent link"},{"type":"text","id":"crumb_label","label":"Breadcrumb current label","info":"Defaults to the page title"},{"type":"text","id":"eyebrow","label":"Eyebrow"},{"type":"text","id":"heading","label":"Heading","info":"Defaults to the page, article or collection title"},{"type":"richtext","id":"text","label":"Intro text","info":"Collections and articles fall back to their description/excerpt"},{"type":"image_picker","id":"image","label":"Image"},{"type":"checkbox","id":"use_resource_image","label":"Use collection/article image when no image is set","default":true},{"type":"header","content":"Buttons"},{"type":"text","id":"btn1_label","label":"Primary button label"},{"type":"url","id":"btn1_link","label":"Primary button link"},{"type":"select","id":"btn1_style","label":"Primary button style","options":[{"value":"navy","label":"Navy"},{"value":"accent","label":"Blue"}],"default":"navy"},{"type":"text","id":"btn2_label","label":"Secondary button label"},{"type":"url","id":"btn2_link","label":"Secondary button link"}],"blocks":[{"type":"meta","name":"Fact","limit":5,"settings":[{"type":"text","id":"label","label":"Label","default":"Lead time"},{"type":"text","id":"value","label":"Value","default":"Quoted per project"}]}],"presets":[{"name":"AF · Page header"}]}
{% endschema %}