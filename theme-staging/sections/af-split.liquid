<section{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}"{% endif %} class="af af--{{ section.settings.surface }}{% if section.settings.surface == 'steel' or section.settings.surface == 'deep' or section.settings.surface == 'slate' or section.settings.surface == 'photo' %} af--navy{% endif %} af-section{% if section.settings.padding == 'tight' %} af-section--tight{% elsif section.settings.padding == 'flush-top' %} af-section--flush-top{% endif %}">
  {%- assign s = section.settings -%}
  {%- if s.surface == 'photo' and s.image -%}
    <div class="af-bgphoto" aria-hidden="true">{{ s.image | image_url: width: 2400 | image_tag: widths: '900,1400,2000,2400', sizes: '100vw', loading: 'lazy', alt: '' }}</div>
  {%- endif -%}
  <div class="af-container">
    <div class="af-split{% if s.reverse %} af-split--reverse{% endif %}{% if s.surface == 'photo' and s.image %} af-split--photo{% endif %}">
      {%- unless s.surface == 'photo' and s.image -%}
      <div class="af-split__media{% if s.ratio == 'tall' %} af-split__media--tall{% endif %}{% if s.screen %} af-split__media--screen{% endif %} af-reveal">
        {%- if s.image -%}
          {{ s.image | image_url: width: 1600 | image_tag: widths: '600,900,1200,1600', sizes: '(min-width: 900px) 50vw, 100vw', loading: 'lazy', alt: s.image.alt | default: s.heading }}
        {%- endif -%}
        {%- if s.caption != blank -%}<div class="af-split__caption">{{ s.caption | escape }}</div>{%- endif -%}
      </div>
      {%- endunless -%}
      <div class="af-split__content af-reveal">
        {%- if s.eyebrow != blank -%}<p class="af-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="af-h2">{{ s.heading | escape }}</h2>{%- endif -%}
        {%- if s.lead != blank -%}<div class="af-lead">{{ s.lead }}</div>{%- endif -%}
        {%- if s.body != blank -%}<div class="af-rte{% if s.checks %} af-rte--checks{% endif %}">{{ s.body }}</div>{%- endif -%}
        {%- render 'af-buttons', s: s -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
/* A software screenshot: framed, never cropped from the middle. */
.af-split__media--screen { aspect-ratio: 16 / 10 !important; background: #fff; border: 1px solid var(--af-line); }
.af-split__media--screen img { object-fit: cover; object-position: top left; }
{% endstylesheet %}

{% schema %}
{"name":"AF · Image with text","tag":"div","class":"af-section-wrapper","settings":[{"type":"select","id":"surface","label":"Background","options":[{"value":"light","label":"White"},{"value":"mist","label":"Mist (light gray)"},{"value":"ice","label":"Light gray (same as Mist)"},{"value":"navy","label":"Navy"},{"value":"blueprint","label":"Navy blueprint grid"},{"value":"deep","label":"Midnight blue (gradient)"},{"value":"slate","label":"Slate (dark charcoal)"},{"value":"photo","label":"Photo behind the whole section (uses the image)"},{"value":"stone","label":"Pale blue"}],"default":"light"},{"type":"select","id":"padding","label":"Vertical spacing","options":[{"value":"normal","label":"Normal"},{"value":"tight","label":"Tight"},{"value":"flush-top","label":"No top spacing"}],"default":"normal"},{"type":"text","id":"anchor","label":"Anchor ID","info":"Optional. Lets you link to this section with #anchor-id"},{"type":"image_picker","id":"image","label":"Image"},{"type":"select","id":"ratio","label":"Image shape","options":[{"value":"wide","label":"Landscape"},{"value":"tall","label":"Portrait"}],"default":"wide"},{"type":"checkbox","id":"screen","label":"Image is a software screenshot","info":"Framed, and shown at 16:10 from its top-left corner so the window is not cropped.","default":false},{"type":"text","id":"caption","label":"Image caption"},{"type":"checkbox","id":"reverse","label":"Image on right","default":false},{"type":"text","id":"eyebrow","label":"Eyebrow"},{"type":"text","id":"heading","label":"Heading","default":"Image with text"},{"type":"richtext","id":"lead","label":"Intro text"},{"type":"richtext","id":"body","label":"Body"},{"type":"checkbox","id":"checks","label":"Style bullet lists as checkmarks","default":true},{"type":"header","content":"Buttons"},{"type":"text","id":"btn1_label","label":"Primary button label"},{"type":"url","id":"btn1_link","label":"Primary button link"},{"type":"select","id":"btn1_style","label":"Primary button style","options":[{"value":"navy","label":"Navy"},{"value":"accent","label":"Blue"}],"default":"navy"},{"type":"text","id":"btn2_label","label":"Secondary button label"},{"type":"url","id":"btn2_link","label":"Secondary button link"}],"presets":[{"name":"AF · Image with text"}]}
{% endschema %}
