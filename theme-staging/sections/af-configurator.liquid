{%- liquid
  assign cfg = product.metafields.aquafab.configurator.value
  assign mode = product.metafields.aquafab.purchase_mode.value | default: 'quote'
  assign s = section.settings
-%}
<section id="configure" class="af af--mist af-section">
  <div class="af-container">
    <div class="af-head af-head--split af-reveal">
      <div>
        <p class="af-eyebrow">{{ s.eyebrow | escape }}</p>
        <h2 class="af-h2">{{ s.heading | escape }}</h2>
      </div>
      <div class="af-lead">{% if cfg.intro != blank %}<p>{{ cfg.intro | escape }}</p>{% else %}{{ s.lead }}{% endif %}</div>
    </div>

    <div class="af-config" data-af-config data-mode="{{ mode }}">
      <script type="application/json" data-af-product>
        {"title": {{ product.title | json }}, "price": {{ product.price | json }}, "options": {{ product.options | json }}, "variants": [{%- for v in product.variants -%}{"id": {{ v.id }}, "title": {{ v.title | json }}, "price": {{ v.price }}, "available": {{ v.available | json }}, "option1": {{ v.option1 | json }}, "option2": {{ v.option2 | json }}, "option3": {{ v.option3 | json }}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]}
      </script>

      <div class="af-config__steps">
        {%- if cfg.groups != blank -%}
          {%- for group in cfg.groups -%}
            {%- assign gtype = group.type | default: 'single' -%}
            <fieldset class="af-config__group" data-af-group data-title="{{ group.title | escape }}"{% if group.variant_option %} data-variant-option="{{ group.variant_option }}"{% endif %}{% if group.show_if %} data-show-if-group="af-{{ group.show_if.group }}" data-show-if-value="{{ group.show_if.value | escape }}" hidden{% endif %}>
              <div class="af-config__group-head">
                <div>
                  <legend class="af-config__group-title">{{ group.title | escape }}</legend>
                  {%- if group.help != blank -%}<div class="af-config__group-help">{{ group.help | escape }}</div>{%- endif -%}
                </div>
              </div>
              {%- if gtype == 'fields' -%}
                <div class="af-config__fields">
                  {%- for field in group.fields -%}
                    {%- assign fid = 'cf-' | append: group.id | append: '-' | append: field.id -%}
                    <div class="af-field{% if field.full %} af-field--full{% endif %}">
                      <label for="{{ fid }}">{{ field.label | escape }}</label>
                      {%- if field.type == 'select' -%}
                        <select id="{{ fid }}" data-af-input data-label="{{ field.label | escape }}"><option value="">Select…</option>{% for o in field.options %}<option>{{ o | escape }}</option>{% endfor %}</select>
                      {%- elsif field.type == 'textarea' -%}
                        <textarea id="{{ fid }}" data-af-input data-label="{{ field.label | escape }}" placeholder="{{ field.placeholder | escape }}"></textarea>
                      {%- else -%}
                        <input id="{{ fid }}" type="{{ field.type | default: 'text' }}" data-af-input data-label="{{ field.label | escape }}" placeholder="{{ field.placeholder | escape }}">
                      {%- endif -%}
                      {%- if field.hint != blank -%}<span class="af-field__hint">{{ field.hint | escape }}</span>{%- endif -%}
                    </div>
                  {%- endfor -%}
                </div>
              {%- else -%}
                <div class="af-config__choices">
                  {%- for choice in group.choices -%}
                    {%- assign cid = 'cc-' | append: group.id | append: '-' | append: forloop.index -%}
                    {%- assign cprice = choice.price | default: 0 | times: 100 -%}
                    <div class="af-choice">
                      <input type="{% if gtype == 'multi' %}checkbox{% else %}radio{% endif %}" id="{{ cid }}" name="af-{{ group.id }}" value="{{ choice.name | escape }}" data-name="{{ choice.name | escape }}" data-price="{{ cprice }}"{% if choice.default %} checked{% endif %}>
                      <label class="af-choice__ui" for="{{ cid }}">
                        <span class="af-choice__name">{{ choice.name | escape }}{% if mode == 'buy' and cprice > 0 %}<span class="af-choice__price">+{{ cprice | money_without_trailing_zeros }}</span>{% endif %}</span>
                        {%- if choice.desc != blank -%}<span class="af-choice__desc">{{ choice.desc | escape }}</span>{%- endif -%}
                      </label>
                    </div>
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </fieldset>
          {%- endfor -%}
        {%- else -%}
          {%- for option in product.options_with_values -%}
            {%- unless option.name == 'Title' and option.values.size == 1 -%}
              {%- assign oidx = forloop.index -%}
              <fieldset class="af-config__group" data-af-group data-title="{{ option.name | escape }}" data-variant-option="{{ oidx }}">
                <div class="af-config__group-head"><div><legend class="af-config__group-title">{{ option.name | escape }}</legend></div></div>
                <div class="af-config__choices">
                  {%- for value in option.values -%}
                    <div class="af-choice">
                      <input type="radio" id="co-{{ oidx }}-{{ forloop.index }}" name="af-opt-{{ oidx }}" value="{{ value | escape }}" data-name="{{ value | escape }}" data-price="0"{% if option.selected_value == value %} checked{% endif %}>
                      <label class="af-choice__ui" for="co-{{ oidx }}-{{ forloop.index }}"><span class="af-choice__name">{{ value | escape }}</span></label>
                    </div>
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endunless -%}
          {%- endfor -%}
          <fieldset class="af-config__group" data-af-group data-title="Project notes">
            <div class="af-config__group-head"><div><legend class="af-config__group-title">Project notes</legend><div class="af-config__group-help">Anything specific about your application, space or timeline.</div></div></div>
            <div class="af-config__fields"><div class="af-field af-field--full"><label for="cf-notes">Notes</label><textarea id="cf-notes" data-af-input data-label="Notes"></textarea></div></div>
          </fieldset>
        {%- endif -%}
      </div>

      <aside class="af-summary" aria-live="polite">
        <div class="af-summary__title">Your configuration</div>
        <div class="af-summary__product">{{ product.title | escape }}</div>
        <ul class="af-summary__list" data-af-summary-list></ul>
        <div class="af-summary__total"><span class="af-summary__total-label">{% if mode == 'buy' %}Estimated total{% else %}Pricing{% endif %}</span><span class="af-summary__total-value" data-af-total></span></div>
        <p class="af-summary__note" data-af-total-note></p>
        {%- if mode == 'buy' -%}<button type="button" class="af-btn" data-af-add hidden>Add to cart</button>{%- endif -%}
        <button type="button" class="af-btn{% if mode == 'buy' %} af-btn--ghost{% endif %}" data-af-quote-open>Request a formal quote</button>
        <p class="af-small" data-af-status hidden style="margin-top:10px;color:#ffb4b4"></p>
        <div class="af-summary__trust">
          <div>Every configuration reviewed by an engineer</div>
          <div>Factory-tested before it ships</div>
          <div>Installation, training &amp; lifetime support</div>
        </div>
      </aside>
    </div>

    <div class="af-quote-panel" data-af-quote-panel id="quote" hidden>
      {%- form 'contact', id: 'af-config-quote' -%}
        {%- assign sid = section.id -%}
        <div class="af-form">
          {%- if form.posted_successfully? or form.errors -%}<script>document.currentScript.closest('[data-af-quote-panel]').hidden = false;</script>{%- endif -%}
          {%- if form.posted_successfully? -%}
            <div class="af-alert af-alert--success">Thank you — your configuration was received. An Aquafab engineer will review it and reply with a formal, itemized quote, typically within 2 business days.</div>
          {%- elsif form.errors -%}
            <div class="af-alert af-alert--error">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <div class="af-form__section">Where should we send your quote?</div>
          <input type="hidden" name="contact[Request type]" value="Configured quote">
          <input type="hidden" name="contact[Product]" value="{{ product.title | escape }}">
          <input type="hidden" name="contact[Configuration]" value="" data-af-config-field>
          <div class="af-field"><label for="q-name-{{ sid }}">Full name <span class="af-req">*</span></label><input id="q-name-{{ sid }}" name="contact[name]" autocomplete="name" required></div>
          <div class="af-field"><label for="q-email-{{ sid }}">Work email <span class="af-req">*</span></label><input id="q-email-{{ sid }}" type="email" name="contact[email]" autocomplete="email" required></div>
          <div class="af-field"><label for="q-phone-{{ sid }}">Phone</label><input id="q-phone-{{ sid }}" type="tel" name="contact[phone]" autocomplete="tel"></div>
          <div class="af-field"><label for="q-inst-{{ sid }}">Institution / organization <span class="af-req">*</span></label><input id="q-inst-{{ sid }}" name="contact[Institution]" autocomplete="organization" required></div>
          <div class="af-field"><label for="q-dept-{{ sid }}">Department, lab or PI</label><input id="q-dept-{{ sid }}" name="contact[Department or lab]"></div>
          <div class="af-field"><label for="q-type-{{ sid }}">Organization type</label><select id="q-type-{{ sid }}" name="contact[Organization type]"><option value="">Select…</option><option>University or college</option><option>K–12 school</option><option>Public aquarium, zoo or museum</option><option>Government agency or laboratory</option><option>Private research or industry</option><option>Other</option></select></div>
          <div class="af-field"><label for="q-time-{{ sid }}">Timeline</label><select id="q-time-{{ sid }}" name="contact[Timeline]"><option value="">Select…</option><option>As soon as possible</option><option>Within 3 months</option><option>3–6 months</option><option>6–12 months</option><option>Budgeting for next fiscal year</option></select></div>
          <div class="af-field"><label for="q-fund-{{ sid }}">Funding status</label><select id="q-fund-{{ sid }}" name="contact[Funding status]"><option value="">Select…</option><option>Funds available</option><option>Grant awarded</option><option>Grant proposal in progress (need a budget quote)</option><option>Exploring options</option></select></div>
          <div class="af-field"><label for="q-pay-{{ sid }}">Preferred payment</label><select id="q-pay-{{ sid }}" name="contact[Payment method]"><option value="">Select…</option><option>Purchase order</option><option>Credit card</option><option>Not sure yet</option></select></div>
          <div class="af-field"><label for="q-loc-{{ sid }}">Delivery city / state</label><input id="q-loc-{{ sid }}" name="contact[Delivery location]"></div>
          <div class="af-field af-field--full"><label for="q-body-{{ sid }}">Research goals &amp; notes</label><textarea id="q-body-{{ sid }}" name="contact[body]" placeholder="Species or specimens, experimental protocol, space or utility constraints — anything we should know."></textarea></div>
          <div class="af-form__actions">
            <button type="submit" class="af-btn af-btn--accent">Submit configuration for quote</button>
            <span class="af-form__privacy">We only use your details to prepare your quote.</span>
          </div>
        </div>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{"name":"AF · Configurator","tag":"div","class":"af-section-wrapper","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"System builder"},{"type":"text","id":"heading","label":"Heading","default":"Configure your system"},{"type":"richtext","id":"lead","label":"Intro (used when the product has none)","default":"<p>Choose your options below. Every configuration is reviewed by an Aquafab engineer before we quote, so you can configure with confidence — we'll flag anything that needs adjusting for your application.</p>"},{"type":"paragraph","content":"Options come from the product's Aquafab › Configurator metafield (JSON). Without it, the builder uses the product's own variant options."}],"presets":[{"name":"AF · Configurator"}]}
{% endschema %}