<section{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}"{% endif %} class="af af--{{ section.settings.surface }} af-section{% if section.settings.padding == 'tight' %} af-section--tight{% elsif section.settings.padding == 'flush-top' %} af-section--flush-top{% endif %}">
  <div class="af-container">
    {%- render 'af-head', s: section.settings -%}
    {%- assign pubs = shop.metaobjects.aquafab_publication.values -%}
    {%- if pubs.size > 0 -%}
      <div class="af-lib__list">
        {%- for p in pubs -%}
          <div class="af-res af-reveal">
            <div class="af-res__icon">{% render 'af-icon', name: 'book' %}</div>
            <div>
              <div class="af-res__title">{{ p.title.value | escape }}</div>
              <div class="af-res__meta"><span>{{ p.authors.value | escape }}</span>{% if p.venue.value != blank %}<span><em>{{ p.venue.value | escape }}</em></span>{% endif %}{% if p.year.value != blank %}<span>{{ p.year.value }}</span>{% endif %}{% if p.systems.value != blank %}<span>Equipment: {{ p.systems.value | escape }}</span>{% endif %}</div>
              {%- if p.summary.value != blank -%}<div class="af-res__desc">{{ p.summary.value | escape }}</div>{%- endif -%}
            </div>
            <div class="af-res__action">{%- if p.link.value != blank -%}<a class="af-btn af-btn--sm af-btn--ghost" href="{{ p.link.value }}" target="_blank" rel="noopener">{% render 'af-icon', name: 'external' %}Read</a>{%- endif -%}</div>
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="af-empty af-reveal">
        <h3 class="af-h4" style="margin-bottom:8px">{{ section.settings.empty_heading | escape }}</h3>
        <div>{{ section.settings.empty_text }}</div>
        <div class="af-btns af-btns--center"><a class="af-btn" href="/pages/research-partners#apply">Submit a publication</a></div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{"name":"AF · Publications","tag":"div","class":"af-section-wrapper","settings":[{"type":"select","id":"surface","label":"Background","options":[{"value":"light","label":"White"},{"value":"mist","label":"Mist (light gray)"},{"value":"ice","label":"Ice (light blue)"},{"value":"navy","label":"Navy gradient"},{"value":"blueprint","label":"Navy blueprint grid"}],"default":"light"},{"type":"select","id":"padding","label":"Vertical spacing","options":[{"value":"normal","label":"Normal"},{"value":"tight","label":"Tight"},{"value":"flush-top","label":"No top spacing"}],"default":"normal"},{"type":"text","id":"anchor","label":"Anchor ID","info":"Optional. Lets you link to this section with #anchor-id"},{"type":"header","content":"Heading"},{"type":"text","id":"eyebrow","label":"Eyebrow"},{"type":"text","id":"heading","label":"Heading"},{"type":"richtext","id":"lead","label":"Intro text"},{"type":"select","id":"head_align","label":"Heading alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"split","label":"Split (heading left, intro right)"}],"default":"left"},{"type":"paragraph","content":"Entries come from Content → Metaobjects → Aquafab publication."},{"type":"text","id":"empty_heading","label":"Empty heading","default":"Our publication index is being compiled"},{"type":"richtext","id":"empty_text","label":"Empty text","default":"<p>Published a paper, thesis or conference poster using Aquafab equipment? Send us the citation and we'll feature it here and link it from the equipment you used.</p>"}],"presets":[{"name":"AF · Publications"}]}
{% endschema %}