{%- assign s = section.settings -%}
{%- if s.text != blank -%}
<div class="af af-announce">
  <div class="af-container af-announce__inner">
    {%- if s.label != blank -%}<span class="af-announce__tag">{{ s.label | escape }}</span>{%- endif -%}
    <span class="af-announce__text">{{ s.text | escape }}</span>
    {%- if s.link_label != blank and s.link != blank -%}
      <a class="af-announce__link" href="{{ s.link }}">{{ s.link_label | escape }} <span aria-hidden="true">→</span></a>
    {%- endif -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{"name":"AF · Announcement bar","tag":"div","class":"af-section-wrapper","enabled_on":{"groups":["header"]},"settings":[{"type":"paragraph","content":"A single line for news, events, promotions or sales. Leave the message empty to hide the bar."},{"type":"text","id":"label","label":"Tag (optional)","info":"Short label such as New, Event or Sale"},{"type":"text","id":"text","label":"Message","default":"Now available: PIV flow calibration for flumes and swim tunnels"},{"type":"text","id":"link_label","label":"Link label","default":"Learn more"},{"type":"url","id":"link","label":"Link"}],"presets":[{"name":"AF · Announcement bar"}]}
{% endschema %}