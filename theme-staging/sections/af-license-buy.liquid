{%- comment -%}
  Software license page: real prices and add-to-cart, not the quote flow the hardware
  product page uses. Prices are read from each plan's variant, so they follow the
  product in Shopify admin and are never typed here.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="af af--light af-section" style="padding-top:clamp(32px,4vw,56px)">
  <div class="af-container">
    <nav aria-label="Breadcrumb">
      <ol class="af-crumbs">
        <li><a href="{{ routes.root_url }}">Home</a></li>
        <li><a href="/pages/aquafab-workbench">Aquafab Workbench</a></li>
        <li aria-current="page">{{ product.title | escape }}</li>
      </ol>
    </nav>
    <div class="af-lic-hero">
      <div class="af-reveal">
        {%- if s.eyebrow != blank -%}<p class="af-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        <h1 class="af-pdp__title">{{ product.title | escape }}</h1>
        {%- if s.tagline != blank -%}<p class="af-pdp__tagline">{{ s.tagline | escape }}</p>{%- endif -%}
        <div class="af-pdp__price">
          <span class="af-pdp__price-value">{% if product.price_varies %}From {% endif %}{{ product.price_min | money_without_trailing_zeros }}</span>
          <span class="af-pdp__price-note">{{ s.price_note | escape }}</span>
        </div>
        {%- if s.points != blank -%}<div class="af-rte af-rte--checks" style="margin-top:24px">{{ s.points }}</div>{%- endif -%}
        <div class="af-btns">
          <a class="af-btn af-btn--accent" href="#plans">See plans &amp; pricing</a>
          <a class="af-btn af-btn--ghost" href="/pages/aquafab-workbench#downloads">{{ s.preview_label | default: 'Try the preview' | escape }}</a>
        </div>
      </div>
      <div class="af-lic-hero__media af-reveal">
        {%- if product.featured_media -%}
          {{ product.featured_media | image_url: width: 1600 | image_tag: widths: '600,900,1200,1600', sizes: '(min-width: 900px) 55vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: product.featured_media.alt | default: product.title }}
        {%- elsif s.image -%}
          {{ s.image | image_url: width: 1600 | image_tag: widths: '600,900,1200,1600', sizes: '(min-width: 900px) 55vw, 100vw', loading: 'eager', alt: s.image.alt | default: product.title }}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<section id="plans" class="af af--ice af-section">
  <div class="af-container">
    <div class="af-head af-head--center af-reveal">
      {%- if s.plans_eyebrow != blank -%}<p class="af-eyebrow">{{ s.plans_eyebrow | escape }}</p>{%- endif -%}
      {%- if s.plans_heading != blank -%}<h2 class="af-h2">{{ s.plans_heading | escape }}</h2>{%- endif -%}
      {%- if s.plans_lead != blank -%}<div class="af-lead">{{ s.plans_lead }}</div>{%- endif -%}
    </div>

    <div class="af-plans">
      {%- for block in section.blocks -%}
        {%- if block.type != 'plan' -%}{%- continue -%}{%- endif -%}
        {%- liquid
          assign b = block.settings
          assign p = b.product
          assign v = p.selected_or_first_available_variant
          for x in p.variants
            if x.title == b.variant
              assign v = x
            endif
          endfor
        -%}
        {%- if p == blank -%}{%- continue -%}{%- endif -%}
        <div class="af-plan{% if b.highlight %} af-plan--featured{% endif %} af-reveal" {{ block.shopify_attributes }}>
          {%- if b.badge != blank -%}<span class="af-plan__badge">{{ b.badge | escape }}</span>{%- endif -%}
          <div class="af-plan__name">{{ b.name | default: v.title | escape }}</div>
          <div class="af-plan__price">{{ v.price | money_without_trailing_zeros }}<small>{{ b.price_note | escape }}</small></div>
          {%- if b.blurb != blank -%}<p class="af-plan__blurb">{{ b.blurb | escape }}</p>{%- endif -%}
          {%- if b.features != blank -%}<div class="af-rte af-rte--checks af-plan__features">{{ b.features }}</div>{%- endif -%}
          <form method="post" action="{{ routes.cart_add_url }}" class="af-plan__form">
            <input type="hidden" name="id" value="{{ v.id }}">
            <input type="hidden" name="quantity" value="1">
            <button type="submit" class="af-btn af-btn--block{% if b.highlight %} af-btn--accent{% endif %}"{% unless v.available %} disabled{% endunless %}>{{ b.button_label | default: 'Add to cart' | escape }}</button>
          </form>
        </div>
      {%- endfor -%}
    </div>

    {%- if s.addons_heading != blank -%}
      <div class="af-plans-sub af-reveal">
        <h3 class="af-h4">{{ s.addons_heading | escape }}</h3>
        {%- if s.addons_text != blank -%}<p>{{ s.addons_text | escape }}</p>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="af-plans af-plans--addons">
      {%- for block in section.blocks -%}
        {%- if block.type != 'addon' -%}{%- continue -%}{%- endif -%}
        {%- liquid
          assign b = block.settings
          assign p = b.product
          assign v = p.selected_or_first_available_variant
          for x in p.variants
            if x.title == b.variant
              assign v = x
            endif
          endfor
        -%}
        {%- if p == blank -%}{%- continue -%}{%- endif -%}
        <div class="af-plan af-plan--addon af-reveal" {{ block.shopify_attributes }}>
          <div>
            <div class="af-plan__name">{{ b.name | default: v.title | escape }}</div>
            <div class="af-plan__price af-plan__price--sm">{{ v.price | money_without_trailing_zeros }}</div>
            {%- if b.blurb != blank -%}<p class="af-plan__blurb">{{ b.blurb | escape }}</p>{%- endif -%}
          </div>
          <form method="post" action="{{ routes.cart_add_url }}" class="af-plan__form">
            <input type="hidden" name="id" value="{{ v.id }}">
            <input type="hidden" name="quantity" value="1">
            <button type="submit" class="af-btn af-btn--ghost"{% unless v.available %} disabled{% endunless %}>{{ b.button_label | default: 'Add to cart' | escape }}</button>
          </form>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "description": {{ product.description | strip_html | truncatewords: 60 | json }},
  "brand": { "@type": "Brand", "name": "Aquafab Industries" },
  "category": {{ product.type | json }},
  {%- if product.featured_media %}"image": {{ product.featured_media | image_url: width: 1200 | prepend: 'https:' | json }},{% endif %}
  "url": {{ request.origin | append: product.url | json }},
  "offers": { "@type": "AggregateOffer", "priceCurrency": {{ cart.currency.iso_code | json }}, "lowPrice": {{ product.price_min | divided_by: 100.0 | json }}, "highPrice": {{ product.price_max | divided_by: 100.0 | json }}, "availability": "https://schema.org/InStock" }
}
</script>

