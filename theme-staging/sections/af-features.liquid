<section{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}"{% endif %} class="af af--{{ section.settings.surface }} af-section{% if section.settings.padding == 'tight' %} af-section--tight{% elsif section.settings.padding == 'flush-top' %} af-section--flush-top{% endif %}">
  <div class="af-container">
    {%- render 'af-head', s: section.settings -%}
    <div class="af-grid af-grid--{{ section.settings.columns }}{% if section.settings.style == 'lined' %} af-features--lined{% endif %}">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <div class="af-feature af-reveal" {{ block.shopify_attributes }}>
          {%- if section.settings.style == 'numbered' -%}
            <div class="af-feature__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</div>
          {%- elsif b.icon != 'none' -%}
            <div class="af-feature__icon">{% render 'af-icon', name: b.icon %}</div>
          {%- endif -%}
          {%- if b.title != blank -%}<h3 class="af-feature__title af-h4">{{ b.title | escape }}</h3>{%- endif -%}
          {%- if b.text != blank -%}<div class="af-feature__text">{{ b.text }}</div>{%- endif -%}
          {%- if b.link_label != blank -%}<div style="margin-top:14px"><a class="af-link" href="{{ b.link | default: '#' }}">{{ b.link_label | escape }}</a></div>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    {%- render 'af-buttons', s: section.settings, center: true -%}
  </div>
</section>

{% schema %}
