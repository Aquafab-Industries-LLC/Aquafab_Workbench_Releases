<section{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}"{% endif %} class="af af--{{ section.settings.surface }}{% if section.settings.surface == 'steel' or section.settings.surface == 'deep' or section.settings.surface == 'slate' or section.settings.surface == 'photo' %} af--navy{% endif %} af-section{% if section.settings.padding == 'tight' %} af-section--tight{% elsif section.settings.padding == 'flush-top' %} af-section--flush-top{% endif %}">
  <div class="af-container">
    <div class="af-facts">
      <div class="af-facts__intro af-reveal">
        {%- if section.settings.eyebrow != blank -%}<p class="af-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="af-h2">{{ section.settings.heading | escape }}</h2>{%- endif -%}
        {%- if section.settings.lead != blank -%}<div class="af-rte" style="margin-top:18px">{{ section.settings.lead }}</div>{%- endif -%}
        {%- render 'af-buttons', s: section.settings -%}
      </div>
      <div class="af-facts__card af-reveal">
        {%- if section.settings.card_title != blank -%}<div class="af-facts__title">{{ section.settings.card_title | escape }}</div>{%- endif -%}
        <dl class="af-facts__list">
          {%- for block in section.blocks -%}
            <div class="af-facts__row" {{ block.shopify_attributes }}><dt>{{ block.settings.label | escape }}</dt><dd>{{ block.settings.value }}</dd></div>
          {%- endfor -%}
        </dl>
      </div>
    </div>
  </div>
</section>

{% schema %}
{"name":"AF · Facts card","tag":"div","class":"af-section-wrapper","settings":[{"type":"select","id":"surface","label":"Background","options":[{"value":"light","label":"White"},{"value":"mist","label":"Mist (light gray)"},{"value":"ice","label":"Ice (light blue)"},{"value":"navy","label":"Navy gradient"},{"value":"blueprint","label":"Navy blueprint grid"},{"value":"stone","label":"Stone (warm light gray)"}],"default":"light"},{"type":"select","id":"padding","label":"Vertical spacing","options":[{"value":"normal","label":"Normal"},{"value":"tight","label":"Tight"},{"value":"flush-top","label":"No top spacing"}],"default":"normal"},{"type":"text","id":"anchor","label":"Anchor ID"},{"type":"header","content":"Heading"},{"type":"text","id":"eyebrow","label":"Eyebrow"},{"type":"text","id":"heading","label":"Heading"},{"type":"richtext","id":"lead","label":"Intro text"},{"type":"select","id":"head_align","label":"Heading alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"split","label":"Split (heading left, intro right)"}],"default":"left"},{"type":"text","id":"card_title","label":"Card title"},{"type":"header","content":"Buttons"},{"type":"text","id":"btn1_label","label":"Button 1 label"},{"type":"url","id":"btn1_link","label":"Button 1 link"},{"type":"select","id":"btn1_style","label":"Button 1 style","options":[{"value":"navy","label":"Navy"},{"value":"accent","label":"Blue"}],"default":"navy"},{"type":"text","id":"btn2_label","label":"Button 2 label"},{"type":"url","id":"btn2_link","label":"Button 2 link"}],"blocks":[{"type":"fact","name":"Fact","settings":[{"type":"text","id":"label","label":"Label","default":"Label"},{"type":"inline_richtext","id":"value","label":"Value","default":"Value"}]}],"presets":[{"name":"AF · Facts card","blocks":[{"type":"fact"},{"type":"fact"}]}]}
{% endschema %}