<section{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}"{% endif %} class="af af--{{ section.settings.surface }}{% if section.settings.surface == 'steel' or section.settings.surface == 'deep' or section.settings.surface == 'slate' or section.settings.surface == 'photo' %} af--navy{% endif %} af-section{% if section.settings.padding == 'tight' %} af-section--tight{% elsif section.settings.padding == 'flush-top' %} af-section--flush-top{% endif %}">
  <div class="af-container">
    {%- render 'af-head', s: section.settings -%}
    <div class="af-screens af-reveal">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <figure class="af-screen{% if b.feature %} af-screen--feature{% endif %}" {{ block.shopify_attributes }}>
          {%- if b.image -%}
            <a class="af-screen__media" href="{{ b.image | image_url: width: 1920 }}" target="_blank" rel="noopener" aria-label="Open full size: {{ b.title | escape }}">
              {{ b.image | image_url: width: 1600 | image_tag: widths: '600,900,1200,1600', sizes: '(min-width: 900px) 50vw, 100vw', loading: 'lazy', alt: b.image.alt | default: b.title }}
            </a>
          {%- endif -%}
          {%- if b.title != blank or b.caption != blank -%}
            <figcaption class="af-screen__cap">
              {%- if b.title != blank -%}<strong>{{ b.title | escape }}</strong>{%- endif -%}
              {%- if b.caption != blank -%}<span>{{ b.caption | escape }}</span>{%- endif -%}
            </figcaption>
          {%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
    {%- if section.settings.note != blank -%}<p class="af-screens__note">{{ section.settings.note | escape }}</p>{%- endif -%}
  </div>
</section>

{% stylesheet %}
/* Screenshots: the software's own screens, framed at their own 16:10 and
   anchored top-left, so a window is never cropped through its middle. Two
   columns, with "Show large" spanning the row: at three columns the text in
   the screens was too small to read (Chris 2026-10-29). */
.af-screens { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(22px, 2.4vw, 40px); }
.af-screen { margin: 0; display: flex; flex-direction: column; gap: 12px; min-width: 0; }
.af-screen--feature { grid-column: 1 / -1; }
.af-screen__media { display: block; aspect-ratio: 16 / 10; overflow: hidden; background: #fff; border: 1px solid var(--af-line); border-radius: 12px; box-shadow: 0 1px 2px rgba(12, 30, 60, 0.05), 0 12px 32px rgba(12, 30, 60, 0.08); transition: transform 0.2s, box-shadow 0.2s; }
.af-screen__media:hover { transform: translateY(-2px); box-shadow: 0 2px 4px rgba(12, 30, 60, 0.06), 0 18px 40px rgba(12, 30, 60, 0.14); }
.af-screen__media img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top left; }
.af-screen--feature .af-screen__media { aspect-ratio: 16 / 10; }
.af-screen__cap { display: flex; flex-direction: column; gap: 4px; font-size: 1.02rem; line-height: 1.5; color: var(--af-text); max-width: 70ch; }
.af-screen__cap strong { font-family: var(--af-font-display); font-size: 1.15rem; letter-spacing: -0.01em; }
.af-screen__cap strong { color: var(--af-ink); font-weight: 600; }
.af--navy .af-screen__cap, .af--blueprint .af-screen__cap { color: rgba(255, 255, 255, 0.72); }
.af--navy .af-screen__cap strong, .af--blueprint .af-screen__cap strong { color: #fff; }
.af-screens__note { margin: 26px 0 0; font-size: 0.86rem; color: var(--af-muted); max-width: 80ch; }
.af--navy .af-screens__note, .af--blueprint .af-screens__note { color: rgba(255, 255, 255, 0.6); }

@media (max-width: 640px) { .af-screens { grid-template-columns: 1fr; } }
{% endstylesheet %}

