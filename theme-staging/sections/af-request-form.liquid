{%- assign s = section.settings -%}
{%- assign sid = section.id -%}
<section id="{{ s.anchor | default: 'request-file' | handleize }}" class="af af--{{ s.surface }}{% if s.surface == 'steel' or s.surface == 'deep' or s.surface == 'slate' or s.surface == 'photo' %} af--navy{% endif %} af-section">
  <div class="af-container">
    <div class="af-form-layout">
      <div class="af-reveal">
        {%- if s.eyebrow != blank -%}<p class="af-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="af-h2">{{ s.heading | escape }}</h2>
        {%- if s.lead != blank -%}<div class="af-rte af-rte--checks" style="margin-top:20px">{{ s.lead }}</div>{%- endif -%}
      </div>
      <div class="af-form-card af-reveal">
        {%- form 'contact', id: sid -%}
          <div class="af-form">
            {%- if form.posted_successfully? -%}
              <div class="af-alert af-alert--success">Thank you — your request is in. We'll email the file or a download link within one business day.</div>
            {%- elsif form.errors -%}
              <div class="af-alert af-alert--error">{{ form.errors | default_errors }}</div>
            {%- endif -%}
            <input type="hidden" name="contact[Request type]" value="Document request — {{ page.title | default: request.path }}">
            <div class="af-form__section">What you need</div>
            <div class="af-field af-field--full"><label for="f-file-{{ sid }}">Document requested <span class="af-req">*</span></label><input id="f-file-{{ sid }}" name="contact[Requested file]" required data-af-prefill="file" data-af-request-field placeholder="e.g. Alpha Respirometry manual"></div>
            <div class="af-form__section">Where to send it</div>
            <div class="af-field"><label for="f-name-{{ sid }}">Full name <span class="af-req">*</span></label><input id="f-name-{{ sid }}" name="contact[name]" autocomplete="name" required></div>
            <div class="af-field"><label for="f-email-{{ sid }}">Work email <span class="af-req">*</span></label><input id="f-email-{{ sid }}" type="email" name="contact[email]" autocomplete="email" required></div>
            <div class="af-field"><label for="f-inst-{{ sid }}">Institution / organization <span class="af-req">*</span></label><input id="f-inst-{{ sid }}" name="contact[Institution]" autocomplete="organization" required></div>
            <div class="af-field"><label for="f-prod-{{ sid }}">Aquafab system you own or are evaluating</label><input id="f-prod-{{ sid }}" name="contact[Product]" placeholder="e.g. Alpha Respirometry System"></div>
            <div class="af-field"><label for="f-serial-{{ sid }}">Serial or order number</label><input id="f-serial-{{ sid }}" name="contact[Serial or order number]" placeholder="If you have one"></div>
            <div class="af-field af-field--full"><label for="f-body-{{ sid }}">Anything else?</label><textarea id="f-body-{{ sid }}" name="contact[body]" placeholder="Other documents you need, or what you'll use them for."></textarea></div>
            <div class="af-form__actions">
              <button type="submit" class="af-btn af-btn--accent">Send my request</button>
              <span class="af-form__privacy">Your details are used only to respond to this request.</span>
            </div>
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{"name":"AF · File request form","tag":"div","class":"af-section-wrapper","settings":[{"type":"select","id":"surface","label":"Background","options":[{"value":"light","label":"White"},{"value":"mist","label":"Mist (light gray)"},{"value":"ice","label":"Ice (light blue)"},{"value":"navy","label":"Navy gradient"},{"value":"blueprint","label":"Navy blueprint grid"},{"value":"stone","label":"Stone (warm light gray)"}],"default":"light"},{"type":"text","id":"anchor","label":"Anchor ID","default":"request-file","info":"Request buttons in the resource library jump to #request-file."},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Request a file"},{"type":"text","id":"heading","label":"Heading","default":"Request a document"},{"type":"richtext","id":"lead","label":"Side text"}],"presets":[{"name":"AF · File request form"}]}
{% endschema %}