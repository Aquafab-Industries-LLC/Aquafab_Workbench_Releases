<section{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}"{% endif %} class="af af--{{ section.settings.surface }} af-section{% if section.settings.padding == 'tight' %} af-section--tight{% elsif section.settings.padding == 'flush-top' %} af-section--flush-top{% endif %}">
  <div class="af-container">
    <div style="margin-inline:auto;max-width:{% if section.settings.width == 'narrow' %}48.75rem{% else %}65rem{% endif %}">
      {%- if section.settings.eyebrow != blank -%}<p class="af-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="af-h2" style="margin-bottom:24px">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      <div class="af-rte af-rte--checks af-reveal">
        {%- if section.settings.content != blank -%}{{ section.settings.content }}{%- endif -%}
        {%- if section.settings.show_page_content and page.content != blank -%}{{ page.content }}{%- endif -%}
        {%- if section.settings.show_page_content and article -%}{{ article.content }}{%- endif -%}
      </div>
      {%- render 'af-buttons', s: section.settings -%}
    </div>
  </div>
</section>

{% schema %}
{"name":"AF · Rich text","tag":"div","class":"af-section-wrapper","settings":[{"type":"select","id":"surface","label":"Background","options":[{"value":"light","label":"White"},{"value":"mist","label":"Mist (light gray)"},{"value":"ice","label":"Ice (light blue)"},{"value":"navy","label":"Navy gradient"},{"value":"blueprint","label":"Navy blueprint grid"}],"default":"light"},{"type":"select","id":"padding","label":"Vertical spacing","options":[{"value":"normal","label":"Normal"},{"value":"tight","label":"Tight"},{"value":"flush-top","label":"No top spacing"}],"default":"normal"},{"type":"text","id":"anchor","label":"Anchor ID","info":"Optional. Lets you link to this section with #anchor-id"},{"type":"select","id":"width","label":"Width","options":[{"value":"narrow","label":"Narrow (reading)"},{"value":"wide","label":"Wide"}],"default":"narrow"},{"type":"text","id":"eyebrow","label":"Eyebrow"},{"type":"text","id":"heading","label":"Heading"},{"type":"richtext","id":"content","label":"Content"},{"type":"checkbox","id":"show_page_content","label":"Also show the page's own content (from Online Store → Pages)","default":false},{"type":"header","content":"Buttons"},{"type":"text","id":"btn1_label","label":"Primary button label"},{"type":"url","id":"btn1_link","label":"Primary button link"},{"type":"select","id":"btn1_style","label":"Primary button style","options":[{"value":"navy","label":"Navy"},{"value":"accent","label":"Blue"}],"default":"navy"},{"type":"text","id":"btn2_label","label":"Secondary button label"},{"type":"url","id":"btn2_link","label":"Secondary button link"}],"presets":[{"name":"AF · Rich text"}]}
{% endschema %}