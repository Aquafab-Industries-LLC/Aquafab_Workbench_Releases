<section{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}"{% endif %} class="af af--{{ section.settings.surface }} af-section{% if section.settings.padding == 'tight' %} af-section--tight{% elsif section.settings.padding == 'flush-top' %} af-section--flush-top{% endif %}">
  <div class="af-container">
    <div class="af-trust af-reveal">
      {%- if section.settings.label != blank -%}<div class="af-trust__label">{{ section.settings.label | escape }}</div>{%- endif -%}
      {%- for block in section.blocks -%}
        <div class="af-trust__item" {{ block.shopify_attributes }}>
          {%- if block.settings.logo -%}<span class="af-trust__logo{% if block.settings.logo_only %} af-trust__logo--wide{% endif %}">{{ block.settings.logo | image_url: width: 320 | image_tag: loading: 'lazy', alt: block.settings.name }}</span>{%- else -%}<span class="af-trust__mark" aria-hidden="true">{% render 'af-icon', name: 'university' %}</span>{%- endif -%}
          {%- unless block.settings.logo and block.settings.logo_only -%}<span class="af-trust__name">{{ block.settings.name | escape }}</span>{%- endunless -%}
        </div>
      {%- endfor -%}
      {%- if section.settings.more_label != blank -%}<a class="af-trust__more" href="{{ section.settings.more_link | default: '/pages/who-we-serve' }}">{{ section.settings.more_label | escape }}</a>{%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  /* Institution logos sit where the generic icon was, at the icon's height, with the name
     beside them. Wordmarks (logo_only) get more width and no typed name. */
  .af-trust__logo { display: inline-flex; align-items: center; flex: none; height: 34px; }
  .af-trust__logo img { height: 34px; width: auto; max-width: 48px; object-fit: contain; display: block; }
  .af-trust__logo--wide img { height: 30px; max-width: 170px; }
{% endstylesheet %}

{% schema %}
{"name":"AF · Trust strip","tag":"div","class":"af-section-wrapper","settings":[{"type":"select","id":"surface","label":"Background","options":[{"value":"light","label":"White"},{"value":"mist","label":"Mist (light gray)"},{"value":"ice","label":"Light gray (same as Mist)"},{"value":"navy","label":"Navy"},{"value":"blueprint","label":"Navy blueprint grid"}],"default":"light"},{"type":"select","id":"padding","label":"Vertical spacing","options":[{"value":"normal","label":"Normal"},{"value":"tight","label":"Tight"},{"value":"flush-top","label":"No top spacing"}],"default":"tight"},{"type":"text","id":"anchor","label":"Anchor ID","info":"Optional. Lets you link to this section with #anchor-id"},{"type":"text","id":"label","label":"Label","default":"Trusted by research and teaching programs at"},{"type":"text","id":"more_label","label":"More link label","default":"+ more institutions"},{"type":"url","id":"more_link","label":"More link"}],"blocks":[{"type":"item","name":"Institution","settings":[{"type":"text","id":"name","label":"Name","default":"Institution"},{"type":"image_picker","id":"logo","label":"Logo (optional)","info":"Shown small beside the name, in place of the generic icon. Use the institution's square mark or shield."},{"type":"checkbox","id":"logo_only","label":"Logo already includes the name","info":"For a wordmark logo: shows the logo wider and hides the typed name.","default":false}]}],"presets":[{"name":"AF · Trust strip","blocks":[{"type":"item"},{"type":"item"},{"type":"item"}]}]}
{% endschema %}